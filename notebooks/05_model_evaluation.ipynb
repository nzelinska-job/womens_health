    "def plot_results_comparison(results_dict):\n",
    "    \"\"\"Compare model results\"\"\"\n",
    "    metrics = ['accuracy', 'precision_weighted', 'recall_weighted', 'f1_weighted', 'auc_weighted']\n",
    "    models = list(results_dict.keys())\n",
    "    \n",
    "    fig, axes = plt.subplots(2, 3, figsize=(18, 12))\n",
    "    axes = axes.flatten()\n",
    "    \n",
    "    for idx, metric in enumerate(metrics):\n",
    "        if idx >= len(axes):\n",
    "            break\n",
    "            \n",
    "        ax = axes[idx]\n",
    "        values = [results_dict[model][metric] for model in models]\n",
    "        \n",
    "        bars = ax.bar(models, values, alpha=0.8, \n",
    "                     color=['#ff9999', '#66b3ff', '#99ff99'][:len(models)])\n",
    "        ax.set_title(f'{metric.replace(\"_\", \" \").title()}')\n",
    "        ax.set_ylabel('Score')\n",
    "        ax.set_ylim(0, 1)\n",
    "        \n",
    "        # Add value labels on bars\n",
    "        for bar, value in zip(bars, values):\n",
    "            if not np.isnan(value):\n",
    "                height = bar.get_height()\n",
    "                ax.text(bar.get_x() + bar.get_width()/2., height + 0.01,\n",
    "                       f'{value:.3f}', ha='center', va='bottom', fontweight='bold')\n",
    "        \n",
    "        ax.grid(True, alpha=0.3)\n",
    "        ax.tick_params(axis='x', rotation=45)\n",
    "    \n",
    "    # Remove empty subplots\n",
    "    for idx in range(len(metrics), len(axes)):\n",
    "        axes[idx].remove()\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Plot results comparison\n",
    "print(\"📊 Model Performance Comparison:\")\n",
    "plot_results_comparison(results_dict)"
   ]
