    "def plot_confusion_matrix(y_true, y_pred, model_name, label_encoder, normalize=True):\n",
    "    \"\"\"Plot confusion matrix\"\"\"\n",
    "    cm = confusion_matrix(y_true, y_pred)\n",
    "    \n",
    "    if normalize:\n",
    "        cm = cm.astype('float') / cm.sum(axis=1)[:, np.newaxis]\n",
    "        fmt = '.2f'\n",
    "        title = f'Normalized Confusion Matrix - {model_name}'\n",
    "        cmap = 'Blues'\n",
    "    else:\n",
    "        fmt = 'd'\n",
    "        title = f'Confusion Matrix - {model_name}'\n",
    "        cmap = 'Blues'\n",
    "    \n",
    "    plt.figure(figsize=(8, 6))\n",
    "    sns.heatmap(cm, annot=True, fmt=fmt, cmap=cmap,\n",
    "                xticklabels=label_encoder.classes_,\n",
    "                yticklabels=label_encoder.classes_)\n",
    "    plt.title(title)\n",
    "    plt.ylabel('True Phase')\n",
    "    plt.xlabel('Predicted Phase')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Plot confusion matrices for all models\n",
    "print(\"🎯 Confusion Matrices:\")\n",
    "for model_name, (predictions, _) in predictions_dict.items():\n",
    "    test_y = y_test_seq if model_name == 'LSTM' else y_test\n",
    "    plot_confusion_matrix(test_y, predictions, model_name, classifier.label_encoder)"
   ]
