    "def plot_feature_importance(model, feature_names, model_name='XGBoost', top_n=20):\n",
    "    \"\"\"Plot feature importance\"\"\"\n",
    "    if hasattr(model, 'feature_importances_'):\n",
    "        importance = model.feature_importances_\n",
    "    elif hasattr(model, 'estimators_'):\n",
    "        # For ensemble models, use first estimator\n",
    "        importance = model.estimators_[0].feature_importances_\n",
    "    else:\n",
    "        print(f\"Feature importance not available for {model_name}\")\n",
    "        return\n",
    "    \n",
    "    # Create importance DataFrame\n",
    "    importance_df = pd.DataFrame({\n",
    "        'feature': feature_names,\n",
    "        'importance': importance\n",
    "    }).sort_values('importance', ascending=False).head(top_n)\n",
    "    \n",
    "    # Plot\n",
    "    plt.figure(figsize=(12, 8))\n",
    "    sns.barplot(data=importance_df, y='feature', x='importance', palette='viridis')\n",
    "    plt.title(f'Top {top_n} Feature Importance - {model_name}')\n",
    "    plt.xlabel('Feature Importance')\n",
    "    plt.ylabel('Features')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    return importance_df\n",
    "\n",
    "# Plot feature importance for tree-based models\n",
    "print(\"🌳 Feature Importance Analysis:\")\n",
    "\n",
    "# XGBoost feature importance\n",
    "print(\"\\n📊 XGBoost Feature Importance:\")\n",
    "xgb_importance = plot_feature_importance(\n",
    "    classifier.models['xgboost'], classifier.feature_names, 'XGBoost', top_n=20\n",
    ")\n",
    "\n",
    "# Ensemble feature importance\n",
    "print(\"\\n🤝 Ensemble Feature Importance:\")\n",
    "ensemble_importance = plot_feature_importance(\n",
    "    classifier.models['ensemble'], classifier.feature_names, 'Ensemble', top_n=20\n",
    ")"
   ]
  },
