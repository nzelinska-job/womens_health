    "def plot_per_class_metrics(results_dict, label_encoder):\n",
    "    \"\"\"Plot per-class metrics\"\"\"\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(20, 6))\n",
    "    metrics = ['precision_per_class', 'recall_per_class', 'f1_per_class']\n",
    "    metric_names = ['Precision', 'Recall', 'F1-Score']\n",
    "    \n",
    "    for idx, (metric, name) in enumerate(zip(metrics, metric_names)):\n",
    "        ax = axes[idx]\n",
    "        \n",
    "        x = np.arange(len(label_encoder.classes_))\n",
    "        width = 0.25\n",
    "        \n",
    "        colors = ['#ff9999', '#66b3ff', '#99ff99']\n",
    "        \n",
    "        for i, model in enumerate(results_dict.keys()):\n",
    "            values = results_dict[model][metric]\n",
    "            bars = ax.bar(x + i*width, values, width, label=model, \n",
    "                         alpha=0.8, color=colors[i % len(colors)])\n",
    "            \n",
    "            # Add value labels\n",
    "            for bar, value in zip(bars, values):\n",
    "                height = bar.get_height()\n",
    "                ax.text(bar.get_x() + bar.get_width()/2., height + 0.01,\n",
    "                       f'{value:.2f}', ha='center', va='bottom', fontsize=8)\n",
    "        \n",
    "        ax.set_xlabel('Cycle Phase')\n",
    "        ax.set_ylabel(name)\n",
    "        ax.set_title(f'{name} by Cycle Phase')\n",
    "        ax.set_xticks(x + width)\n",
    "        ax.set_xticklabels(label_encoder.classes_, rotation=45)\n",
    "        ax.legend()\n",
    "        ax.grid(True, alpha=0.3)\n",
    "        ax.set_ylim(0, 1.1)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Plot per-class metrics\n",
    "print(\"📈 Per-Class Performance:\")\n",
    "plot_per_class_metrics(results_dict, classifier.label_encoder)"
