# GitHub Authentication - Create your token at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Repository Configuration - Update with your repository details
GITHUB_OWNER=your-github-username
GITHUB_REPO=cycle-tracker-data
GITHUB_BRANCH=main

# Application Settings
DEFAULT_CYCLE_LENGTH=28
MIN_CYCLE_LENGTH=21
MAX_CYCLE_LENGTH=35

# Environment
ENVIRONMENT=development
DEBUG=true